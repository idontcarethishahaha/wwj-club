<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="org.mdxq.wwjclub.ums.dao.EmpMapper">
    <insert id="insert">

    </insert>



    <delete id="delete">

    </delete>

    <delete id="deleteBatch">

    </delete>

    <update id="update">

    </update>

    <!--只查询未删除（deleted = 0）的记录-->
    <select id="selectById" resultType="emp">
        select * from ums_emp
        where id = #{id} and deleted = 0
    </select>

    <select id="list" resultType="emp">
        select * from ums_emp
        <where>
            deleted = 0
        </where>
    </select>
</mapper>